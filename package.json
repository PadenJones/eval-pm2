{
  "name": "eval-pm2",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "server.js",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "test": "jest --testPathIgnorePatterns='\\.pm2.test.js$' --watch",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:test": "TARGET=pm2 jest \\.pm2.test.js$ --watch",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@padenjones/utils": "^1.0.0",
    "express": "^5.2.1",
    "pm2": "^7.0.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "prettier": "3.9.8"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/jest.setup.cjs"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!@padenjones/utils)"
    ]
  }
}
